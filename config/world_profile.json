 "seabed":      {"medium": "underwater", "tags": ["ocean", "sea", "underwater", "water", "coral", "reef", "deep"]},
 "jungle":      {"tags": ["jungle", "forest", "trees", "tropical", "green"]},
 "gold_city":   {"tags": ["gold", "city", "treasure", "rich"]},
 "stone_court": {"tags": ["ruins", "stone", "graveyard", "dark", "castle"]},
 "sky_island":  {"tags": ["sky", "island", "clouds", "meadow", "floating"]},
