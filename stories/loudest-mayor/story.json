 "scenes": [
  {"loc": "home", "line": "In this town, the *loudest* kid becomes mayor.", "title": "IN THIS TOWN...", "shot": "wide", "camera": {"target": "group", "angle": 15, "move": "push"},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": 20, "expr": "happy"}, {"id": "zoe", "at": [1.5, 0], "face": -20, "anim": "wave", "expr": "grin"}],
   "sfx": [{"name": "boom", "at": "w:loudest"}]},
  {"line": "Just for one day. Every single *week*.", "shot": "medium", "camera": {"target": "zoe", "angle": -20},
   "actors": [{"id": "zoe", "at": [1.5, 0], "face": 0, "anim": "talk", "expr": "happy"}]},
  {"line": "Last week, Jay won by screaming at a *pigeon*.", "shot": "medium", "camera": {"target": "jay", "angle": 20},
   "actors": [{"id": "jay", "at": [0, 0], "face": 0, "anim": "angry", "expr": "angry"}],
   "sfx": [{"name": "crowd_laugh", "at": "w:pigeon", "vol": 0.4}]},
  {"line": "The pigeon *left*. Jay still got the crown.", "shot": "close", "camera": {"target": "jay", "angle": -15},
   "actors": [{"id": "jay", "at": [0, 0], "face": 0, "anim": "idle", "expr": "smug"}],
   "props": [{"type": "trophy", "hand": "jay", "pop": true}]},
  {"line": "Mayor Jay banned Mondays. It did not *work*.", "shot": "wide", "camera": {"target": "jay", "angle": 25},
   "actors": [{"id": "jay", "at": [0, 0], "face": 0, "anim": "cheer", "expr": "laugh"}],
   "sfx": [{"name": "sad_trombone", "at": "w:work"}]},
  {"line": "This week, I wanted that *crown*.", "shot": "close", "punch": true, "camera": {"target": "milo", "angle": 15},
   "actors": [{"id": "milo", "at": [0, 0], "face": 0, "anim": "think", "expr": "smug"}],
   "fx": [{"type": "sparkles", "on": "milo", "mode": "burst", "at": "w:crown"}], "sfx": [{"name": "ding", "at": "w:crown"}]},
  {"line": "My plan? Free pizza Fridays. Yelled very *loudly*.", "shot": "medium", "camera": {"target": "milo", "angle": 20},
   "actors": [{"id": "milo", "at": [0, 0], "face": 0, "anim": "cheer", "expr": "laugh"}],
   "props": [{"type": "pizzabox", "hand": "milo"}]},
  {"loc": "skate", "line": "The contest started at the *skatepark*.", "shot": "establishing", "camera": {"target": "group", "angle": 30, "move": "pan"},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 20, "anim": "idle", "expr": "confident"}, {"id": "zoe", "at": [0, 1], "face": 0, "anim": "idle", "expr": "happy"}, {"id": "jay", "at": [3, 0], "face": -20, "anim": "idle", "expr": "smug"}]},
  {"line": "Jay went first. *AAAAAH!* Nine out of ten.", "shot": "close", "camera": {"target": "jay", "angle": -20},
   "actors": [{"id": "jay", "at": [3, 0], "face": -30, "anim": "angry", "expr": "angry"}],
   "overlay": ["speedlines"], "sfx": [{"name": "boom", "at": "w:AAAAAH"}]},
  {"line": "Then I took a *deep* breath.", "shot": "close", "camera": {"target": "milo", "angle": 15, "move": "push"},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 20, "anim": "idle", "expr": "confident"}],
   "sfx": [{"name": "riser", "at": 0.2}]},
  {"line": "I screamed *so* hard the pigeons fled.", "shot": "low", "punch": true, "shakeAt": "w:screamed", "camera": {"target": "milo", "angle": 0, "shake": 0.5},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 0, "anim": "angry", "expr": "shocked"}],
   "overlay": ["speedlines", "flash"], "sfx": [{"name": "vineboom", "at": "w:screamed"}]},
  {"line": "Ten out of ten! New *record*!", "shot": "medium", "camera": {"target": "milo", "angle": 20},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 0, "anim": "dab", "expr": "laugh"}],
   "fx": [{"type": "confetti", "on": "milo", "mode": "burst", "at": "w:record"}], "sfx": [{"name": "tada", "at": "w:record"}]},
  {"line": "But the town got *competitive*.", "shot": "wide", "camera": {"target": "group", "angle": 10},
   "actors": [{"id": "zoe", "at": [0, 1], "face": 0, "anim": "angry", "expr": "angry"}, {"id": "jay", "at": [3, 0], "face": -20, "anim": "angry", "expr": "angry"}]},
  {"line": "Everyone started shouting. At the *same* time.", "shot": "full", "camera": {"target": "group", "angle": 15, "move": "orbit", "shake": 0.3},
   "actors": [{"id": "milo", "at": [-3, 0], "anim": "angry", "expr": "angry"}, {"id": "zoe", "at": [0, 1], "anim": "angry", "expr": "angry"}, {"id": "jay", "at": [3, 0], "anim": "angry", "expr": "angry"}],
   "overlay": ["speedlines"], "sfx": [{"name": "crowd_gasp", "at": 0.3, "vol": 0.5}]},
  {"line": "Windows shook. Dogs *howled*.", "shot": "wide", "camera": {"target": "group", "angle": 0, "shake": 0.6},
   "shakeAt": 0.5, "sfx": [{"name": "thunder", "at": 0.3, "vol": 0.6}]},
  {"line": "Nobody could hear *anything*.", "shot": "close", "camera": {"target": "zoe", "angle": 15},
   "actors": [{"id": "zoe", "at": [0, 1], "face": 0, "anim": "angry", "expr": "angry"}],
   "overlay": ["vignette"]},
  {"line": "Then I noticed something. *Max* was missing.", "shot": "close", "punch": true, "camera": {"target": "milo", "angle": 20},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 0, "anim": "idle", "expr": "worried"}],
   "sfx": [{"name": "dun_dun_dun", "at": "w:Max"}]},
  {"line": "My little brother was somewhere, *calling* for me.", "shot": "top", "camera": {"target": "milo", "move": "rise"},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 0, "anim": "idle", "expr": "scared"}]},
  {"line": "But the town was too *loud*.", "shot": "medium", "camera": {"target": "milo", "angle": -20},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 0, "anim": "scared", "expr": "scared"}],
   "overlay": ["red"]},
  {"line": "So I did something *crazy*.", "shot": "close", "camera": {"target": "milo", "angle": 15},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 0, "anim": "idle", "expr": "confident"}]},
  {"line": "I climbed a ramp and shouted: *QUIET!*", "shot": "low", "punch": true, "camera": {"target": "milo", "angle": 0},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 0, "anim": "point", "expr": "angry"}],
   "sfx": [{"name": "record_scratch", "at": "w:QUIET"}]},
  {"line": "Everybody *froze*.", "shot": "wide", "camera": {"target": "group", "angle": 10},
   "actors": [{"id": "zoe", "at": [0, 1], "face": 0, "anim": "shocked", "expr": "shocked"}, {"id": "jay", "at": [3, 0], "face": -20, "anim": "shocked", "expr": "shocked"}],
   "sfx": [{"name": "crickets", "at": 0.3, "vol": 0.6}]},
  {"line": "And in the silence, I heard a tiny *voice*.", "shot": "close", "camera": {"target": "milo", "angle": 20, "move": "push"},
   "actors": [{"id": "milo", "at": [-3, 0], "face": 40, "anim": "idle", "expr": "worried"}],
   "sfx": [{"name": "heartbeat", "at": 0.3}]},
  {"line": "Milo? I'm stuck behind the *ramp*.", "shot": "medium", "camera": {"target": "max", "angle": -20},
   "actors": [{"id": "max", "at": [6, -4], "face": -30, "anim": "sitfloor", "expr": "sad"}]},
  {"line": "I ran faster than I *ever* had.", "shot": "wide", "camera": {"target": "milo", "angle": 60, "move": "pan"},
   "actors": [{"id": "milo", "at": [-3, 0], "to": [5, -3], "anim": "run", "after": "idle", "expr": "worried"}],
   "sfx": [{"name": "cartoon_run", "at": 0.1}]},
  {"line": "Max was fine. Just scared, and a little *dusty*.", "shot": "medium", "camera": {"target": "group", "angle": 20},
   "actors": [{"id": "milo", "at": [5, -3], "face": "max", "anim": "hug", "expr": "love"}, {"id": "max", "at": [6.5, -4], "face": "milo", "anim": "hug", "expr": "happy"}],
   "fx": [{"type": "hearts", "on": "max", "mode": "rise", "at": "w:fine"}]},
  {"line": "The whole town had followed me. *Silently*.", "shot": "wide", "camera": {"target": "group", "angle": 10, "move": "pull"},
   "actors": [{"id": "zoe", "at": [-1, 2], "face": "max", "anim": "idle", "expr": "worried"}, {"id": "jay", "at": [1, 3], "face": "max", "anim": "idle", "expr": "worried"}, {"id": "max", "at": [2.5, 0], "face": 0, "anim": "idle", "expr": "happy"}],
   "sfx": [{"name": "crowd_aww", "at": "w:Silently", "vol": 0.5}]},
  {"line": "Then Zoe said, *softly*: we need a new rule.", "shot": "close", "camera": {"target": "zoe", "angle": 20},
   "actors": [{"id": "zoe", "at": [-1, 2], "face": 30, "anim": "talk", "expr": "content"}]},
  {"line": "Whoever *listens* best becomes mayor.", "shot": "medium", "punch": true, "camera": {"target": "group", "angle": 15},
   "actors": [{"id": "zoe", "at": [-1, 2], "face": 30, "anim": "point", "expr": "happy"}, {"id": "jay", "at": [1, 3], "face": 0, "anim": "cheer", "expr": "laugh"}],
   "fx": [{"type": "sparkles", "on": "zoe", "mode": "burst", "at": "w:listens"}], "sfx": [{"name": "ding", "at": "w:listens"}]},
  {"line": "They crowned me. Mayor Milo, *Quietest* in town.", "shot": "medium", "camera": {"target": "milo", "angle": -15},
   "actors": [{"id": "milo", "at": [5, -3], "face": 0, "anim": "cheer", "expr": "laugh"}],
   "props": [{"type": "trophy", "hand": "milo", "pop": true}], "fx": [{"type": "confetti", "on": "milo", "mode": "burst", "at": "w:Quietest"}], "sfx": [{"name": "tada", "at": "w:Quietest"}]},
  {"line": "My first law? Free pizza Fridays. *Whispered*.", "shot": "close", "camera": {"target": "milo", "angle": 15},
   "actors": [{"id": "milo", "at": [5, -3], "face": 0, "anim": "talk", "expr": "smug"}],
   "props": [{"type": "pizzabox", "hand": "milo", "pop": true}]},
  {"line": "And Jay? He *lost* his voice for a week.", "shot": "close", "camera": {"target": "jay", "angle": -20},
   "actors": [{"id": "jay", "at": [1, 3], "face": 0, "anim": "shrug", "expr": "sad"}],
   "sfx": [{"name": "sad_trombone", "at": "w:lost"}]},
  {"line": "Turns out the best way to be heard is to *listen*.", "shot": "wide", "camera": {"target": "group", "angle": 15, "move": "rise"},
   "actors": [{"id": "milo", "at": [5, -3], "face": "max", "anim": "idle", "expr": "happy"}, {"id": "max", "at": [6.5, -4], "face": "milo", "anim": "dance", "expr": "laugh"}],
   "transition": "fade", "fadeOut": true}
 ]
}
