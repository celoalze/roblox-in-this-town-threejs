 },
 "scenes": [
  {"line": "In this town, if you tell a *lie*, you can't stop laughing.", "title": "IN THIS TOWN...", "emotion": "mysterious",
   "shot": "wide", "camera": {"target": "group", "move": "push", "angle": 15},
   "actors": [{"id": "jay", "at": [-3, 1], "face": 20, "anim": "idle", "expr": "neutral", "actions": [{"at": "w:laughing", "anim": "laugh", "expr": "happy"}]},
              {"id": "milo", "at": [2, 0], "face": -20, "anim": "idle", "expr": "neutral", "actions": [{"at": "w:laughing", "expr": "surprised"}]}],
   "sfx": [{"name": "crowd_laugh", "at": "w:laughing", "vol": 0.5}]},
  {"line": "Which is why I've *never* lied. Not once.", "emotion": "calm",
   "shot": "medium", "camera": {"target": "milo", "move": "push", "angle": 20},
   "actors": [{"id": "milo", "at": [0, 0], "face": 0, "anim": "idle", "expr": "smug"}]},
  {"line": "Until Zoe asked me *one* question.", "emotion": "mysterious",
   "shot": "full", "camera": {"target": "group", "move": "drift", "angle": -25},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": 60, "anim": "idle", "expr": "neutral"},
              {"id": "zoe", "at": [9, 3], "to": [2, 0.5], "face": "milo", "expr": "angry"}]},
  {"line": "Did you eat my *cookies*?", "speaker": "zoe", "emotion": "angry",
   "shot": "close", "camera": {"target": "zoe", "move": "push", "angle": -30}, "punch": true,
   "actors": [{"id": "zoe", "at": [2, 0.5], "face": "milo", "anim": "point", "expr": "angry"}, {"id": "milo", "at": [-1.5, 0], "face": "zoe", "expr": "nervous"}],
   "sfx": [{"name": "dun_dun_dun", "at": "w:cookies", "vol": 0.7}]},
  {"line": "What? No way! [laugh]", "speaker": "milo", "emotion": "nervous",
   "shot": "close", "camera": {"target": "milo", "move": "push", "angle": 30},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": "zoe", "anim": "idle", "expr": "nervous", "actions": [{"at": "70%", "anim": "laugh", "expr": "laugh"}]}, {"id": "zoe", "at": [2, 0.5], "face": "milo", "expr": "angry"}]},
  {"line": "And then... it *started*.", "emotion": "dramatic",
   "shot": "medium", "camera": {"target": "milo", "move": "push", "angle": 10, "shake": 0.6},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": 20, "anim": "laugh", "expr": "laugh"}],
   "sfx": [{"name": "record_scratch", "at": 0.1, "vol": 0.6}]},
  {"line": "I laughed so hard, the whole *plaza* stared.", "emotion": "funny",
   "shot": "wide", "camera": {"target": "milo", "move": "pull", "angle": -15},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": 0, "anim": "laugh", "expr": "laugh"},
              {"id": "jay", "at": [-7, 4], "face": "milo", "anim": "point", "expr": "shocked"},
              {"id": "zoe", "at": [2, 0.5], "face": "milo", "anim": "idle", "expr": "angry"}],
   "sfx": [{"name": "crowd_gasp", "at": "w:stared", "vol": 0.6}]},
  {"line": "You're the *worst*!", "speaker": "zoe", "emotion": "angry",
   "shot": "close", "camera": {"target": "zoe", "move": "push", "angle": -25},
   "actors": [{"id": "zoe", "at": [2, 0.5], "face": "milo", "anim": "idle", "expr": "angry", "actions": [{"at": "w:worst", "to": [10, 6]}]}, {"id": "milo", "at": [-1.5, 0], "face": "zoe", "anim": "laugh", "expr": "laugh"}]},
  {"line": "But here's the *thing*.", "emotion": "sad",
   "shot": "medium", "camera": {"target": "milo", "move": "drift", "angle": 25},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": 30, "anim": "idle", "expr": "sad"}]},
  {"line": "I *didn't* eat her cookies.", "emotion": "sad",
   "shot": "close", "camera": {"target": "milo", "move": "push", "angle": 15},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": 10, "anim": "idle", "expr": "worried"}]},
  {"line": "So why was I *laughing*?", "emotion": "shocked", "punch": true,
   "shot": "close", "camera": {"target": "milo", "move": "push", "angle": 0, "zoom": 0.8},
   "actors": [{"id": "milo", "at": [-1.5, 0], "face": 0, "anim": "idle", "expr": "shocked"}],
   "sfx": [{"name": "boom", "at": "w:laughing", "vol": 0.7}]},
  {"line": "Unless someone made me *lie*... without me knowing.", "emotion": "mysterious",
   "shot": "wide", "camera": {"target": [ -9, 4.5, 6 ], "move": "push", "angle": 160},
   "actors": [{"id": "jay", "at": [-9, 6], "face": "milo", "anim": "idle", "expr": "smug"}, {"id": "milo", "at": [-1.5, 0], "face": 0, "anim": "idle", "expr": "worried"}],
   "sfx": [{"name": "dun_dun_dun", "at": "w:knowing", "vol": 0.6}]}
 ]
